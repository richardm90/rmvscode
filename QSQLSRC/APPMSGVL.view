--------------------------------------------------------------------------------
-- APPMSGVL   - Application Messages List View
--
-- 07/04/2021 - RM - created
--------------------------------------------------------------------------------

CREATE OR REPLACE VIEW APPMSGVL
  AS ( SELECT
         ID,
         JOB_NAME,
         FIELD_NAME,
         TYPE,
         TEXT,
         CREATED_BY_PROCESS,
         CREATED_BY_PGM,
         CREATED_BY_PRC,
         CREATED_BY_USER,
         CREATED_TIMESTAMP
       FROM
         APPMSGVP );

LABEL ON TABLE APPMSGVL IS 'Application Messages List View';
