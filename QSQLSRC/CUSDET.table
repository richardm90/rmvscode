--------------------------------------------------------------------------------
-- CUSDET     - Customer Details
--
-- 06/04/2021 - RM - created
--------------------------------------------------------------------------------

CREATE OR REPLACE TABLE CUSDET (
  ID                 FOR COLUMN CUSID     INTEGER         GENERATED BY DEFAULT AS IDENTITY,
  CODE               FOR COLUMN CUSCODE   CHAR(10)        NOT NULL,
  STATUS             FOR COLUMN CUSSTAT   CHAR(1)         NOT NULL             WITH DEFAULT 'N',
  NAME               FOR COLUMN CUSNAME   VARCHAR(40)     ALLOCATE(40) NOT NULL,
  ADDRESS_LINE1      FOR COLUMN CUSADD1   VARCHAR(40)     ALLOCATE(40) NOT NULL WITH DEFAULT '',
  ADDRESS_LINE2      FOR COLUMN CUSADD2   VARCHAR(40)     ALLOCATE(40) NOT NULL WITH DEFAULT '',
  ADDRESS_LINE3      FOR COLUMN CUSADD3   VARCHAR(40)     ALLOCATE(40) NOT NULL WITH DEFAULT '',
  ADDRESS_LINE4      FOR COLUMN CUSADD4   VARCHAR(40)     ALLOCATE(40) NOT NULL WITH DEFAULT '',
  POSTCODE           FOR COLUMN CUSPCOD   VARCHAR(10)     ALLOCATE(10) NOT NULL WITH DEFAULT '',
  CONTACT_NAME       FOR COLUMN CUSCONT   VARCHAR(20)     ALLOCATE(20) NOT NULL WITH DEFAULT '',
  CONTACT_TELP       FOR COLUMN CUSTELP   VARCHAR(20)     ALLOCATE(20) NOT NULL WITH DEFAULT '',
  CONTACT_EMAIL      FOR COLUMN CUSEMAIL  VARCHAR(80)     ALLOCATE(40) NOT NULL WITH DEFAULT '',
  VAT_CODE           FOR COLUMN CUSVATC   CHAR(2)         NOT NULL              WITH DEFAULT '',
  CURRENCY           FOR COLUMN CUSCURR   CHAR(3)         NOT NULL              WITH DEFAULT '',
  CREDIT_LIMIT       FOR COLUMN CUSCRED   DECIMAL(11, 2)  NOT NULL              WITH DEFAULT 0,
  CURRENT_BALANCE    FOR COLUMN CUSCBAL   DECIMAL(11, 2)  NOT NULL              WITH DEFAULT 0,
  COMMENTS           FOR COLUMN CUSCOMM   VARCHAR(1024)   ALLOCATE(80) NOT NULL WITH DEFAULT '',
  CREATED_BY_USER    FOR COLUMN CUSCRTUSR VARCHAR(18)     ALLOCATE(18) NOT NULL WITH DEFAULT USER,
  CREATED_TIMESTAMP  FOR COLUMN CUSCRTSTM TIMESTAMP       NOT NULL              WITH DEFAULT CURRENT_TIMESTAMP,

  -- Not available at 7.2
  -- AUDIT_TYPE_CHANGE  CHAR(1)      GENERATED ALWAYS AS (DATA CHANGE OPERATION),
  -- AUDIT_USER         VARCHAR(128) GENERATED ALWAYS AS (SESSION_USER),
  -- AUDIT_CLIENT_IP    VARCHAR(128) GENERATED ALWAYS AS (SYSIBM.CLIENT_IPADDR),
  -- AUDIT_JOB_NAME     VARCHAR(28)  GENERATED ALWAYS AS (QSYS2.JOB_NAME),
  -- AUDIT_TIME         TIMESTAMP FOR EACH ROW ON UPDATE AS ROW CHANGE TIMESTAMP NOT NULL,

  CONSTRAINT CUSDETPK PRIMARY KEY (ID)
);

LABEL ON TABLE CUSDET IS 'Customer Details';

LABEL ON COLUMN CUSDET
( ID                 TEXT IS 'Id' ,
  CODE               TEXT IS 'Customer Code' ,
  NAME               TEXT IS 'Customer Name' ,
  ADDRESS_LINE1      TEXT IS 'Address Line 1' ,
  ADDRESS_LINE2      TEXT IS 'Address Line 2' ,
  ADDRESS_LINE3      TEXT IS 'Address Line 3' ,
  ADDRESS_LINE4      TEXT IS 'Address Line 4' ,
  POSTCODE           TEXT IS 'Postcode' ,
  CONTACT_NAME       TEXT IS 'Contact Name' ,
  CONTACT_TELP       TEXT IS 'Contact Telephone' ,
  CONTACT_EMAIL      TEXT IS 'Contact Email' ,
  VAT_CODE           TEXT IS 'VAT Code' ,
  CURRENCY           TEXT IS 'Currency Code' ,
  CREDIT_LIMIT       TEXT IS 'Credit Limit' ,
  CURRENT_BALANCE    TEXT IS 'Current Balance' ,
  COMMENTS           TEXT IS 'Comments' ,
  CREATED_BY_USER    TEXT IS 'Created By User',
  CREATED_TIMESTAMP  TEXT IS 'Created Timestamp' ) ;
