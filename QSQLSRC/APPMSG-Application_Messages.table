--------------------------------------------------------------------------------
-- APPMSG     - Application Messages
--
-- 07/04/2021 - RM - created
--------------------------------------------------------------------------------

CREATE OR REPLACE TABLE APPMSG (
  ID                 INTEGER      GENERATED BY DEFAULT AS IDENTITY,
  JOB_NAME           VARCHAR(28)  ALLOCATE(28)  NOT NULL ,
  FIELD_NAME         CHAR(10)     NOT NULL,
  TYPE               CHAR(1)      NOT NULL,
  TEXT               VARCHAR(512) ALLOCATE(128) NOT NULL,
  CREATED_BY_PROCESS CHAR(10)     NOT NULL,
  CREATED_BY_PGM     CHAR(10)     NOT NULL,
  CREATED_BY_PRC     VARCHAR(128) ALLOCATE(32) NOT NULL,
  CREATED_BY_USER    VARCHAR(18)  ALLOCATE(18) NOT NULL,
  CREATED_TIMESTAMP  TIMESTAMP    NOT NULL,
  CONSTRAINT APPMSGPK PRIMARY KEY (ID) ) ;

LABEL ON TABLE APPMSG IS 'Application Messages' ;

LABEL ON COLUMN APPMSG
( ID                 TEXT IS 'Id' ,
  JOB_NAME           TEXT IS 'Job Name' ,
  FIELD_NAME         TEXT IS 'Field Name' ,
  TYPE               TEXT IS 'Message Type' ,
  TEXT               TEXT IS 'Message Text' ,
  CREATED_BY_PROCESS TEXT IS 'Created By Process',
  CREATED_BY_PGM     TEXT IS 'Created By Program',
  CREATED_BY_PRC     TEXT IS 'Created By Procedure',
  CREATED_BY_USER    TEXT IS 'Created By User',
  CREATED_TIMESTAMP  TEXT IS 'Created Timestamp' ) ;
