/* Have to delete the BNDDIR, or it will always be older than the source */
/* because the CRTBNDDIR will fail the second time and only the ADDBNDDIRE */
/* is executed */
!DLTOBJ OBJ(&O/&N) OBJTYPE(*BNDDIR)
CRTBNDDIR BNDDIR(&O/&N) +
          TEXT('RMTOOLS: Application Binding Directory')
ADDBNDDIRE BNDDIR(&O/&N) +
   OBJ( (*LIBL/RMAPP *SRVPGM) )