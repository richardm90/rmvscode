      **************************************************************************
      * WRKCUS     - Work With Customers
      *
      * 14/04/2021 - RM - created
      **************************************************************************
      *
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CF03
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                      CF13
     A                                      CF14
     A                                      CF15
     A                                      PRINT
     A                                      INDARA
     A                                      PAGEDOWN
     A                                      PAGEUP
      *
      * Subfile record
     A          R WRKCUSAS                  SFL
     A            DARRN          5S 0H
     A            DASID         10S 0H
     A            DASSTAT        5A  O  6  3DSPATR(HI)
     A            DASCODE       10A  O    +2DSPATR(HI)
     A            DASNAME       40A  O    +2DSPATR(HI)
     A            DASPCOD       10A  O    +2DSPATR(HI)
      *
      * Subfile control
     A          R WRKCUSAC                  SFLCTL(WRKCUSAS)
     A                                      SFLSIZ(15)
     A                                      SFLPAG(15)
     A                                      OVERLAY
     A                                      KEEP
     A  36                                  SFLDSP
     A  37                                  SFLDSPCTL
     A  38                                  SFLEND
     A  39                                  SFLCLR
     A                                      SFLCSRRRN(&DACRRN)
     A                                      RTNCSRLOC(&DARCD &DAFLD)
     A            DACRRN         5S 0H
     A            DARCD         10A  H
     A            DAFLD         10A  H
     A            DATITLE       28A  O  1  2DSPATR(HI)
      *
     A                                  3  2'Search'
     A            DASEARCH      40A  B    +2DSPATR(HI)
     A                                      LOWER
      *
     A                                  3 61'Page'
     A            DAPAGE         3Y 0B    +1DSPATR(HI)
     A                                      EDTCDE(Z)
     A            DATOPG         6A  O    +1DSPATR(HI)
      *
     A                                  5  2'Status'
     A                                  5 10'Code'
     A                                  5 22'Name'
     A                                  5 64'Postcode'
      *
      * Subfile FOOTER
     A          R WRKCUSAF
     A                                      OVERLAY
     A                                      KEEP
     A            DAFKY1        65A  O 21  2COLOR(BLU)
     A            DAMORE         7A  O 21 70DSPATR(HI)
     A*           DAFKY2        30A  O 22  2COLOR(BLU)
      *
      *=========================================================================
      * Common message subfile
      *=========================================================================
      *
      * Subfile record
     A          R MSGSFL                    SFL
     A            MSRRN          5S 0H
     A            MSMSG         77A  O 22  2
     A  35                                  DSPATR(RI)
     A  35                                  COLOR(RED)
      *
      * Subfile control
     A          R MSGCTL                    SFLCTL(MSGSFL)
     A                                      SFLSIZ(2)
     A                                      SFLPAG(1)
     A                                      OVERLAY
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLEND
     A  34                                  SFLCLR
     A*            DBFKY1        30A  O 12  2COLOR(BLU)
     A*            DBFKY2        30A  O 13  2COLOR(BLU)
      *
      *=========================================================================
      * Common footer
      *=========================================================================
      *
     A          R FOOTER
     A            FTPANEL       10A    23  2
     A            FTUSER        10A       +2
     A            FTDATE        10A       +2
     A            FTTIME        10A       +2