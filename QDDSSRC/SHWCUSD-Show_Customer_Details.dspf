      **************************************************************************
      * SHWCUS     - Show Customer Details
      *
      * 14/04/2021 - RM - created
      **************************************************************************
      *
     A                                      DSPSIZ(24 80  *DS3)
     A                                      CF03
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                      CF13
     A                                      CF14
     A                                      CF15
     A                                      PRINT
     A                                      INDARA
     A          R SHWCUSA
     A                                      OVERLAY
     A                                      KEEP
     A            DATITLE       28A  O  1  2DSPATR(HI)
      *
     A                                  3  2'Code'
     A            DACODE        10A  O  3 11DSPATR(HI)
     A            DAID          20A  O    +2DSPATR(HI)
      *
     A                                  5  2'Name'
     A            DANAME        40A  O  5 11DSPATR(HI)
      *
     A                                  7  2'Address'
     A            DAADD1        40A  O  7 11DSPATR(HI)
     A            DAADD2        40A  O  8 11DSPATR(HI)
     A            DAADD3        40A  O  9 11DSPATR(HI)
     A            DAADD4        40A  O 10 11DSPATR(HI)
     A            DAPCOD        10A  O 11 11DSPATR(HI)
      *
     A                                 13  2'Contact'
     A            DACONT        68A  O 13 11DSPATR(HI)
     A            DAEMAIL       68A  O 14 11DSPATR(HI)
      *
     A                                 16  2'Credit Limit'
     A            DACRED        11Y 2O    +2DSPATR(HI)
     A                                      EDTCDE(4)
     A                                    +2'VAT'
     A            DAVATC         2A  O    +2DSPATR(HI)
     A                                    +2'Currency'
     A            DACURC         3A  O    +2DSPATR(HI)
      *
     A                                 18  2'Comments'
     A            DACOMM       120A  O 18 11DSPATR(HI)
      *
     A            DAFKY1        65A  O 21  2COLOR(BLU)
      *
      *=========================================================================
      * Common message subfile
      *=========================================================================
      *
      * Subfile record
     A          R MSGSFL                    SFL
     A            MSRRN          5S 0H
     A            MSMSG         77A  O 22  2
     A  35                                  DSPATR(RI)
     A  35                                  COLOR(RED)
      *
      * Subfile control
     A          R MSGCTL                    SFLCTL(MSGSFL)
     A                                      SFLSIZ(2)
     A                                      SFLPAG(1)
     A                                      OVERLAY
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLEND
     A  34                                  SFLCLR
     A*            DBFKY1        30A  O 12  2COLOR(BLU)
     A*            DBFKY2        30A  O 13  2COLOR(BLU)
      *
      *=========================================================================
      * Common footer
      *=========================================================================
      *
     A          R FOOTER
     A            FTPANEL       10A    23  2
     A            FTUSER        10A       +2
     A            FTDATE        10A       +2
     A            FTTIME        10A       +2