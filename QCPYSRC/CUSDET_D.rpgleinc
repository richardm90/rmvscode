//========================================================================
// Define global data structures
//========================================================================

dcl-ds t_CUSDET_SP_add_nulls qualified template inz;
  ID               like(t_NULLIND) inz(c_NULL_VALUE);
  CODE             like(t_NULLIND) inz(c_NULL_VALUE);
  STATUS           like(t_NULLIND) inz(c_NULL_VALUE);
  NAME             like(t_NULLIND) inz(c_NULL_VALUE);
  ADDRESS_LINE1    like(t_NULLIND) inz(c_NULL_VALUE);
  ADDRESS_LINE2    like(t_NULLIND) inz(c_NULL_VALUE);
  ADDRESS_LINE3    like(t_NULLIND) inz(c_NULL_VALUE);
  ADDRESS_LINE4    like(t_NULLIND) inz(c_NULL_VALUE);
  POSTCODE         like(t_NULLIND) inz(c_NULL_VALUE);
  CONTACT_NAME     like(t_NULLIND) inz(c_NULL_VALUE);
  CONTACT_TELP     like(t_NULLIND) inz(c_NULL_VALUE);
  CONTACT_EMAIL    like(t_NULLIND) inz(c_NULL_VALUE);
  VAT_CODE         like(t_NULLIND) inz(c_NULL_VALUE);
  CURRENCY         like(t_NULLIND) inz(c_NULL_VALUE);
  CREDIT_LIMIT     like(t_NULLIND) inz(c_NULL_VALUE);
  CURRENT_BALANCE  like(t_NULLIND) inz(c_NULL_VALUE);
  COMMENTS         like(t_NULLIND) inz(c_NULL_VALUE);
  error            like(t_NULLIND) inz(c_NULL_VALUE);
  error_msg        like(t_NULLIND) inz(c_NULL_VALUE);
  session_id       like(t_NULLIND) inz(c_NULL_VALUE);
end-ds;

