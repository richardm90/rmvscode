dcl-ds t_CUSDET_SP_get_nulls qualified template inz;
  ID               like(t_NULLIND) inz(c_NULL_VALUE);
  CODE             like(t_NULLIND) inz(c_NULL_VALUE);
  STATUS           like(t_NULLIND) inz(c_NULL_VALUE);
  NAME             like(t_NULLIND) inz(c_NULL_VALUE);
