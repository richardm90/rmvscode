dcl-ds t_CUSDET_SP_list_nulls qualified template inz;
  req_page      like(t_NULLIND) inz(c_NULL_VALUE);
  req_page_rows like(t_NULLIND) inz(c_NULL_VALUE);
  sel_CODE      like(t_NULLIND) inz(c_NULL_VALUE);
  sel_STATUS    like(t_NULLIND) inz(c_NULL_VALUE);
  sel_NAME      like(t_NULLIND) inz(c_NULL_VALUE);
  sel_SEARCH    like(t_NULLIND) inz(c_NULL_VALUE);
