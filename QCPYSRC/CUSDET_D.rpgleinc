  error_msg        like(t_NULLIND) inz(c_NULL_VALUE);
  session_id    like(t_NULLIND) inz(c_NULL_VALUE);
end-ds;

//========================================================================
// Define global prototypes
//========================================================================

dcl-pr CUSDET_new likeds(t_CUSDET) end-pr;

dcl-pr CUSDET_add like(t_BOOLEAN);
  data likeds(t_CUSDET);
end-pr;

dcl-pr CUSDET_get like(t_BOOLEAN);
  data likeds(t_CUSDET);
end-pr;

dcl-pr CUSDET_update like(t_BOOLEAN);
  data likeds(t_CUSDET);
end-pr;

dcl-pr CUSDET_delete like(t_BOOLEAN);
  data likeds(t_CUSDET);
end-pr;

dcl-pr CUSDET_list like(t_UNSIGNED_INTEGER);
  calc likeds(APP_paging_t);
  sel  likeds(t_CUSDET_list_selections) const;
  data likeds(t_CUSDET_list) dim(APP_MAXIMUM_PAGE_ROWS);
end-pr;

dcl-pr CUSDET_fetch like(t_BOOLEAN);
  sel  likeds(t_CUSDET_fetch_selections) const;
  data likeds(t_CUSDET_list);
end-pr;

dcl-pr CUSDET_error like(t_BOOLEAN) end-pr;

dcl-pr CUSDET_found like(t_BOOLEAN) end-pr;

dcl-pr CUSDET_exists like(t_BOOLEAN);
  CODE like(t_CUSDET_CODE) const;
  ID   like(t_INTEGER) const options(*nopass);
end-pr;
