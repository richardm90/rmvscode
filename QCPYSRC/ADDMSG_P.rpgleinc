//==============================================================================

/if defined(ADDMSG_P)
/eof
/endif
/define ADDMSG_P

//==============================================================================

dcl-proc addmsg;
  dcl-pi *n;
    text like(APMSAL_text_t) const;
    field_name like(t_FIELD_NAME) const options(*nopass);
    type like(APMSAL_type_t) const options(*nopass);
  end-pi;

  if %parms() >= %parmnum(type);
    APMSAL_add(text: type: field_name);
  elseif %parms() >= %parmnum(field_name);
    APMSAL_add(text: APMSAL_TYPE_ERROR: field_name);
  else;
    APMSAL_add(text: APMSAL_TYPE_ERROR);
  endif;

  return;
end-proc;

//==============================================================================

dcl-proc addmsg_diag;
  dcl-pi *n;
    text like(APMSAL_text_t) const;
    field_name like(t_FIELD_NAME) const options(*nopass);
  end-pi;

  if %parms() >= %parmnum(field_name);
    addmsg(text: field_name: APMSAL_TYPE_DIAGNOSTIC);
  else;
    addmsg(text: c_APP_ADDMSG_FIELD_NAME_NONE: APMSAL_TYPE_DIAGNOSTIC);
  endif;

  return;
end-proc;

//==============================================================================

dcl-proc addmsg_info;
  dcl-pi *n;
    text like(APMSAL_text_t) const;
    field_name like(t_FIELD_NAME) const options(*nopass);
  end-pi;

  if %parms() >= %parmnum(field_name);
    addmsg(text: field_name: APMSAL_TYPE_INFORMATION);
  else;
    addmsg(text: c_APP_ADDMSG_FIELD_NAME_NONE: APMSAL_TYPE_INFORMATION);
  endif;

  return;
end-proc;
