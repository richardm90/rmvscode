**free

//==============================================================================
// CUSDETDL_D - Customer Details DAL Copybook
//
// 07/04/2021 - RM - created
//==============================================================================

/if defined(CUSDETDL_D)
/eof
/endif
/define CUSDETDL_D

//========================================================================
// Copybook definitions
//========================================================================

/include 'QCPYSRC/APP_D.rpgleinc'
/include 'QCPYSRC/RMAPP_D.rpgleinc'

//========================================================================
// Define global data structures
//========================================================================

// /if defined(APP_DATA_OR_SERVICE_LAYER)

dcl-ds CUSDET_t qualified template inz;
  ID                     like(INTEGER_t);
  CODE                   like(CUSDET_CODE_t);
  STATUS                 like(CUSDET_STATUS_t);
  NAME                   like(CUSDET_NAME_t);
  ADDRESS_LINE1          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE2          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE3          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE4          like(CUSDET_ADDRESS_LINE_t);
  POSTCODE               like(CUSDET_POSTCODE_t);
  CONTACT_NAME           like(CUSDET_CONTACT_NAME_t);
  CONTACT_TELP           like(CUSDET_CONTACT_TELP_t);
  CONTACT_EMAIL          like(CUSDET_CONTACT_EMAIL_t);
  VAT_CODE               like(CUSDET_VAT_CODE_t);
  CURRENCY               like(CUSDET_CURRENCY_t);
  CREDIT_LIMIT           like(CUSDET_CREDIT_LIMIT_t);
  CURRENT_BALANCE        like(CUSDET_CURRENT_BALANCE_t);
  COMMENTS               like(CUSDET_COMMENTS_t);
  CREATED_BY_USER        varchar(18);
  CREATED_TIMESTAMP      timestamp;
  // AUDIT_TYPE_CHANGE      char(1);
  // AUDIT_USER             varchar(128);
  // AUDIT_CLIENT_IP        varchar(128);
  // AUDIT_JOB_NAME         varchar(28);
  // AUDIT_TIME             timestamp;
end-ds;

dcl-ds CUSDET_list_t qualified template inz;
  ID                     like(INTEGER_t);
  CODE                   like(CUSDET_CODE_t);
  STATUS                 like(CUSDET_STATUS_t);
  STATUS_DESCRIPTION     like(CUSDET_STATUS_DESCRIPTION_t);
  NAME                   like(CUSDET_NAME_t);
  ADDRESS_LINE1          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE2          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE3          like(CUSDET_ADDRESS_LINE_t);
  ADDRESS_LINE4          like(CUSDET_ADDRESS_LINE_t);
  POSTCODE               like(CUSDET_POSTCODE_t);
  CONTACT_NAME           like(CUSDET_CONTACT_NAME_t);
  CONTACT_TELP           like(CUSDET_CONTACT_TELP_t);
  CONTACT_EMAIL          like(CUSDET_CONTACT_EMAIL_t);
  VAT_CODE               like(CUSDET_VAT_CODE_t);
  CURRENCY               like(CUSDET_CURRENCY_t);
  CREDIT_LIMIT           like(CUSDET_CREDIT_LIMIT_t);
  CURRENT_BALANCE        like(CUSDET_CURRENT_BALANCE_t);
  COMMENTS               like(CUSDET_COMMENTS_t);
end-ds;

dcl-ds CUSDET_list_selections_t qualified template inz;
  CODE                   like(CUSDET_CODE_t);
  STATUS                 like(CUSDET_STATUS_t);
  NAME                   like(CUSDET_NAME_t);
  SEARCH                 like(CUSDET_NAME_t);
end-ds;

dcl-ds CUSDET_fetch_selections_t qualified template inz;
  ID                     like(INTEGER_t);
  NOT_ID                 like(FLAG_t) inz('N');
  CODE                   like(CUSDET_CODE_t);
end-ds;

// /endif

//========================================================================
// Define field templates
//========================================================================

dcl-s CUSDET_CODE_t               char(10) template;
dcl-s CUSDET_STATUS_t             char(1) template;
dcl-s CUSDET_STATUS_DESCRIPTION_t varchar(40) template;
dcl-s CUSDET_NAME_t               varchar(40) template;
dcl-s CUSDET_ADDRESS_LINE_t       varchar(40) template;
dcl-s CUSDET_POSTCODE_t           varchar(10) template;
dcl-s CUSDET_CONTACT_NAME_t       varchar(20) template;
dcl-s CUSDET_CONTACT_TELP_t       varchar(20) template;
dcl-s CUSDET_CONTACT_EMAIL_t      varchar(80) template;
dcl-s CUSDET_VAT_CODE_t           char(2) template;
dcl-s CUSDET_CURRENCY_t           char(3) template;
dcl-s CUSDET_CREDIT_LIMIT_t       packed(11:2) template;
dcl-s CUSDET_CURRENT_BALANCE_t    packed(11:2) template;
dcl-s CUSDET_COMMENTS_t           varchar(1024) template;

//========================================================================
// Define global constants
//========================================================================

dcl-c CUSDET_STATUS_ACTIVE      'A';
dcl-c CUSDET_STATUS_CLOSED      'C';
dcl-c CUSDET_STATUS_NEW         'N';

//========================================================================
// Define global prototypes
//========================================================================

dcl-pr CUSDETDL_add like(BOOLEAN_t);
  data likeds(CUSDET_t);
end-pr;

dcl-pr CUSDETDL_get like(BOOLEAN_t);
  data likeds(CUSDET_t);
end-pr;

dcl-pr CUSDETDL_update like(BOOLEAN_t);
  data likeds(CUSDET_t);
end-pr;

dcl-pr CUSDETDL_delete like(BOOLEAN_t);
  data likeds(CUSDET_t);
end-pr;

dcl-pr CUSDETDL_list like(UNSIGNED_INTEGER_t);
  calc likeds(APP_paging_t);
  sel  likeds(CUSDET_list_selections_t) const;
  data likeds(CUSDET_list_t) dim(APP_MAXIMUM_PAGE_ROWS);
end-pr;

dcl-pr CUSDETDL_error like(BOOLEAN_t) end-pr;

dcl-pr CUSDETDL_found like(BOOLEAN_t) end-pr;

dcl-pr CUSDETDL_fetch like(BOOLEAN_t);
  sel  likeds(CUSDET_fetch_selections_t) const;
  data likeds(CUSDET_list_t);
end-pr;
